# Variáveis opcionais da stack Docker local; consumidas pelo docker-compose.yml.
# Este modelo permite preparar o assistente sem publicar credenciais.
# Em uma instalação nova, copie para .env na raiz. Preserve um .env já existente.
# Sem chave, o assistente funciona com ajuda local.
ASSISTANT_MODE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Para ativar Gemini, preencha a chave apenas no .env privado e use modo gemini.
# Confirme o tier do projeto no AI Studio; uma chave não comprova gratuidade.
# Demais variáveis opcionais e padrões da stack estão no docker-compose.yml.
