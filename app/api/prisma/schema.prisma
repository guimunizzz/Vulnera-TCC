// Vulnera — Prisma Schema
// ============================================================================
// Banco: MySQL 8 (local via docker compose)
// ORM: Prisma 5.x
// ============================================================================
//
// FILOSOFIA DESTE SCHEMA
//
// 1) Isolamento Tenable/Wiz-like:
//    Cada Vulnerability é uma INSTÂNCIA INDIVIDUAL. Pertence a UM Project,
//    que pertence a UMA Application, que pertence a UMA Company. Não há
//    nenhuma "lib global de vulnerabilidades". Mesmo que duas Companies
//    tenham a mesma CVE em apps idênticos, são 2 registros independentes.
//
// 2) Multi-tenant por chave estrangeira:
//    Toda entidade derivada (Project, Vulnerability, Evidence) carrega
//    companyId desnormalizado (mesmo quando já é alcançável por FK). Isso
//    permite filtro O(1) por tenant em qualquer query e evita JOINs em
//    todas as listagens. O Service garante consistência ao criar.
//
// 3) Sem enums nativos:
//    String + validação em TypeScript. Razão: portabilidade entre
//    MySQL/PostgreSQL e evita migration toda vez que adiciona valor.
//
// 4) IDs cuid():
//    Curto, URL-safe, ordenável por criação. Suficiente pra TCC.
//
// 5) Soft-delete não-implementado:
//    Pra TCC, delete é hard. Se entrar soft-delete, adicionar `deletedAt`.
//
// ============================================================================
// ESTADO POR ONDA
// ============================================================================
//   ✅ MVP (sprints 1-5): User, Company, Plan, Subscription, RefreshToken,
//                          PasswordResetToken, Application, Project,
//                          ProjectMember, Vulnerability, Evidence,
//                          VulnerabilityComment, AuditLog
//   🔜 Pós-MVP (sprints 6-8): MaturityDomain, MaturityControl,
//                              MaturityAssessment, MaturityScore,
//                              Notification, Report
//   ❄️  Futuro (depois TCC): ChatMessage, SupportTicket
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTIDADE E ACESSO
// ============================================================================

// User — qualquer pessoa que loga
// role: "ADMIN" | "PENTESTER" | "CLIENT"
// companyRole: "OWNER" | "MEMBER" | null (somente CLIENTs têm companyRole)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String // bcrypt cost 12 — NUNCA armazenar em claro
  name          String
  role          String   @default("CLIENT")
  companyId     String?
  companyRole   String?
  expoPushToken String? // Fase 7 — token do Expo Push Service; null até o app mobile registrar (POST /notifications/register-push)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company             Company?               @relation(fields: [companyId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  projectMembers      ProjectMember[]
  vulnerabilities     Vulnerability[]        @relation("VulnerabilityAssignee")
  vulnComments        VulnerabilityComment[]
  evidences           Evidence[]
  auditLogs           AuditLog[]
  dastScans           DastScan[]
  dastTriagedFindings DastFinding[] @relation("DastFindingTriagedBy")
  riskAcceptancesRequested RiskAcceptance[] @relation("RiskAcceptanceRequester") // CP-4
  riskAcceptancesReviewed  RiskAcceptance[] @relation("RiskAcceptanceReviewer") // CP-4

  @@index([companyId])
}

// RefreshToken — armazenado HASHEADO (SHA-256). O token bruto vai no cookie.
// Rotacionar a cada refresh: criar novo + revokedAt no antigo.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// PasswordResetToken — link de e-mail. used=true após consumo.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// COMERCIAL
// ============================================================================

// Company — empresa cliente
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?  @unique
  planId    String // plano CONTRATADO inicialmente (referência simbólica;
  // a fonte da verdade do plano ativo é Subscription)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan            Plan            @relation(fields: [planId], references: [id])
  users           User[]
  subscriptions   Subscription[]
  applications    Application[]
  projects        Project[]
  vulnerabilities Vulnerability[]
  auditLogs       AuditLog[]
  slaPolicies     SlaPolicy[] // CP-2 — histórico de políticas de SLA da empresa
  riskAcceptances RiskAcceptance[] // CP-4 — aceites formais de risco da empresa

  @@index([planId])
}

// Plan — catálogo de planos (BASIC, PRO, PRO_PLUS)
model Plan {
  id                  String   @id @default(cuid())
  name                String   @unique
  maxApplications     Int
  maxProjects         Int      @default(1)
  includesRemediation Boolean  @default(false)
  price               Decimal  @db.Decimal(10, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  companies     Company[]
  subscriptions Subscription[]
}

// Subscription — vínculo Company ↔ Plan
// status: PENDING_APPROVAL | ACTIVE | REJECTED | SUSPENDED | CANCELED
// Regra: só pode haver UMA subscription ACTIVE por companyId por vez
model Subscription {
  id         String    @id @default(cuid())
  companyId  String
  planId     String
  status     String    @default("PENDING_APPROVAL")
  startDate  DateTime?
  endDate    DateTime?
  approvedBy String? // userId do admin que aprovou
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  plan    Plan    @relation(fields: [planId], references: [id])

  @@index([companyId])
  @@index([planId])
  // Índice composto crítico: findActiveByCompany(companyId)
  @@index([companyId, status])
}

// ============================================================================
// CATÁLOGO DE APLICAÇÕES
// ============================================================================

// Application — sistema-alvo da análise
// Pertence a UMA Company. Reutilizável entre projetos no tempo.
// RN03: count(Application by company) ≤ plan.maxApplications da Subscription ativa
model Application {
  id          String   @id @default(cuid())
  name        String
  url         String?
  environment String   @default("PROD") // PROD | HOMOL | DEV
  techStack   String?
  description String?  @db.Text
  companyId   String
  isActive    Boolean  @default(true)

  // ---------------------------------------------------------------------
  // Contexto de risco (Exposure & Remediation, CP-1 — 2026-09-15).
  //
  // Quatro fatos sobre o ALVO que o CVSS não sabe: o CVSS mede a falha, isto
  // mede onde ela está. É o que alimenta o Vulnera Risk Score (CP-3) e as
  // Cadeias de Exposição (CP-8). `environment` já existia e entra no mesmo
  // conjunto — é o quinto fator, não foi duplicado.
  //
  // Defaults CONSERVADORES de propósito: uma app nova nasce "média, interna,
  // não exposta". Assumir exposta sem alguém afirmar inflaria o risco de
  // todo mundo; assumir pública sem alguém afirmar esconderia risco real.
  // Meio-termo neutro, e quem sabe preenche.
  //
  // Quem pode SUBIR o risco (CLIENT OWNER) é mais amplo do que quem pode
  // DESCER (só ADMIN) — a regra fina mora em application.service.ts e está
  // registrada em docs/DECISIONS.md D2. Toda mudança gera AuditLog
  // RISK_CONTEXT_CHANGED com antes/depois.
  //
  // Sem tags nesta versão (decisão explícita: seria o primeiro passo rumo a
  // CMDB, e nenhuma feature da iniciativa precisa delas).
  // ---------------------------------------------------------------------
  criticality     String  @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  internetFacing  Boolean @default(false)
  dataSensitivity String  @default("INTERNAL") // PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  businessOwner   String? // texto livre — o dono de negócio quase nunca tem conta no Vulnera
  technicalOwner  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company         @relation(fields: [companyId], references: [id])
  projects        Project[]
  vulnerabilities Vulnerability[]

  @@index([companyId])
  @@index([companyId, isActive])
  // "aplicações críticas da empresa" — recorte do dashboard e do grafo
  @@index([companyId, criticality])
}

// ============================================================================
// PROJETOS DE ANÁLISE
// ============================================================================

// Project — uma análise específica
// status mínima: PENDING | IN_PROGRESS | IN_REVIEW | COMPLETED
// (máquina formal expandirá em sprints posteriores)
// companyId é desnormalizado de Application.companyId — Service mantém
model Project {
  id             String    @id @default(cuid())
  name           String
  description    String?   @db.Text
  applicationId  String
  companyId      String // desnormalizado de Application — multi-tenant filter
  analysisType   String    @default("DAST") // SAST | DAST | MATURITY | COMBO
  analysisLevel  String    @default("BASIC") // BASIC | INTERMEDIATE | ADVANCED
  hasRemediation Boolean   @default(false)
  scopeIn        String?   @db.Text
  scopeOut       String?   @db.Text
  notes          String?   @db.Text
  status         String    @default("PENDING")
  requestedAt    DateTime  @default(now())
  startedAt      DateTime?
  closedAt       DateTime?
  updatedAt      DateTime  @updatedAt

  application     Application     @relation(fields: [applicationId], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])
  members         ProjectMember[]
  vulnerabilities Vulnerability[]

  @@index([companyId])
  @@index([applicationId])
  @@index([status])
  @@index([companyId, status])
}

// ProjectMember — pentesters atribuídos
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ============================================================================
// VULNERABILIDADES (Tenable/Wiz-like — INSTÂNCIA INDIVIDUAL)
// ============================================================================
//
// CADA vulnerability É ÚNICA. Não há "catálogo compartilhado".
// Se duas Companies têm a mesma "SQL Injection em /search", são 2 registros.
//
// Isolamento garantido por 3 FKs (projectId, applicationId, companyId).
// Em queries de listagem, sempre filtrar por companyId primeiro.
//
// Cálculo de severidade:
//   cvssScore (0.0 - 10.0) → severityCalculated automático:
//     0.1-3.9 LOW | 4.0-6.9 MEDIUM | 7.0-8.9 HIGH | 9.0-10.0 CRITICAL
//   severityFinal: pode ser igual à calculated OU override manual
//   Se override, severityOverrideReason é obrigatório (≥ 20 chars)
//
// Status (máquina IMPLEMENTADA — 4 estados, ADR-021):
//   OPEN | IN_PROGRESS | FIXED | CLOSED
//
// ⚠️ Este comentário listava 6 estados (REVALIDATION e RISK_ACCEPTED) e uma
// regra de transição dependente de `project.hasRemediation` (RN13/RN14).
// Nada disso existe no código: o tipo em models/vulnerability.model.ts tem 4
// valores, e `hasRemediation` é gravado e devolvido em DTO mas NUNCA consultado
// por nenhuma regra. Era a máquina CONCEITUAL do vault sendo lida como se fosse
// a implementada. Corrigido em 2026-09-15 (CP-0), conforme a R5 do CLAUDE.md
// §0.1 — o código é a verdade, o doc se ajusta.
//
// Quem pode mudar status: ADMIN, ou PENTESTER membro do Project.
// CLIENT é read-only em Vulnerability.
//
// 🚧 [FUTURO] As transições de RETORNO (IN_PROGRESS→OPEN e FIXED→IN_PROGRESS)
// já foram aprovadas em ADR-033, mas ainda NÃO estão em ALLOWED_TRANSITIONS —
// entram junto do Remediation Kanban. CLOSED segue terminal.
// "Risco aceito" não será status: vira entidade própria (RiskAcceptance),
// com a Vulnerability permanecendo OPEN. Ver docs/DECISIONS.md.
// ============================================================================

model Vulnerability {
  id                     String  @id @default(cuid())
  title                  String
  description            String  @db.Text
  owaspCategory          String // A01..A10 do OWASP Top 10 2021
  cvssVector             String? // CVSS:3.1/AV:N/AC:L/...
  cvssScore              Float?
  severityCalculated     String // LOW | MEDIUM | HIGH | CRITICAL — derivada do cvssScore
  severityFinal          String // pode ser igual à calculada ou override
  severityOverrideReason String? @db.Text
  impact                 String? @db.Text
  recommendation         String? @db.Text
  status                 String  @default("OPEN")
  aiAssisted             Boolean @default(false) // true se Gemini participou da descrição

  // Proveniência (ADR-032). "MANUAL" = pentester digitou depois de análise
  // humana (todo o histórico até 2026-09-09); "DAST_IMPORT" = nasceu da
  // promoção de um DastFinding. Sem isto, misturar as duas origens na mesma
  // tabela degradaria a confiança em Vulnerability como "achado triado por
  // humano" — a objeção nº 3 do ADR-029, agora respondida em vez de evitada.
  //
  // ⚠️ O vetor CVSS de uma promovida NÃO é inventado a partir do riskcode do
  // ZAP: a UI de promoção pré-preenche uma SUGESTÃO e o pentester revisa
  // antes de salvar. Por isso não existe flag de "score estimado" — todo
  // cvssScore do produto continua sendo calculado de um vetor revisado por
  // humano (RN10 intacta).
  sourceType          String  @default("MANUAL")
  sourceDastFindingId String? @unique

  // Foreign keys (cascata de isolamento)
  projectId     String
  applicationId String // desnormalizado de Project.applicationId
  companyId     String // desnormalizado de Project.companyId — multi-tenant
  createdBy     String // userId do pentester que criou
  assignedTo    String? // userId do responsável (cliente ou pentester)

  // ---------------------------------------------------------------------
  // SLA de remediação (Exposure & Remediation, CP-2 — 2026-09-15).
  //
  // 🎯 PERSISTE-SE O PRAZO, DERIVA-SE O ESTADO. `slaDueAt` é congelado no
  // momento do cálculo — mudar a política amanhã NÃO reescreve o prazo de
  // quem já tem um (só ação explícita de ADMIN faz isso, auditada). Já o
  // estado (ON_TRACK / DUE_SOON / BREACHED / RESOLVED_*) é função de
  // (dueAt, pausa, status, agora) e nunca vira coluna: um finding estoura
  // pela passagem do tempo sem ninguém escrever nada. Ver utils/sla.util.ts.
  //
  // slaStartedAt ≠ createdAt de propósito: reabertura (FIXED → IN_PROGRESS,
  // ADR-033) inicia um NOVO ciclo com começo próprio, e o ciclo anterior
  // fica só no AuditLog. slaPausedMs acumula o tempo sob Risk Acceptance
  // aprovado (CP-4) — o prazo efetivo é dueAt + pausa.
  //
  // NULL em todos = finding sem SLA (anterior ao backfill, ou severidade
  // NONE). Backfill aprovado (D1) só toca OPEN/IN_PROGRESS.
  // ---------------------------------------------------------------------
  slaStartedAt DateTime?
  slaDueAt     DateTime? // prazo EFETIVO — empurrado quando uma pausa termina
  slaDueSoonAt DateTime? // instante dos 20% restantes — calculado junto, empurrado junto (ver utils/sla.util.ts)
  slaPausedMs  Int       @default(0) // quanto do prazo veio de pausa (explicabilidade)
  slaPolicyId  String? // qual política gerou o prazo — explicabilidade, sem FK (perder o ponteiro é ok; perder o prazo não)

  // ---------------------------------------------------------------------
  // Vulnera Risk Score (Exposure & Remediation, CP-3 — 2026-09-15).
  //
  // Prioridade CONTEXTUAL, 0–100, ADITIVA (docs/DECISIONS.md D3):
  //   round(cvss × 6) + criticidade + ambiente + exposição + sensibilidade
  // O CVSS continua intacto e continua sendo a base de severityCalculated
  // (RN10); o VRS é uma coluna A MAIS. Persistido porque a busca ordena e
  // filtra por ele no banco — calcular em memória seria o anti-pattern que a
  // FEAT-09 eliminou. `vrsFactors` guarda cada parcela: um score que não se
  // explica não sobrevive à primeira discordância.
  //
  // NADA temporal entra aqui (SLA fica fora): o score gravado e o exibido são
  // idênticos até uma mudança REAL de input (vetor CVSS ou contexto da app).
  // NULL = cvssScore nulo (não zero: sem vetor não há como priorizar).
  // ---------------------------------------------------------------------
  vrsScore      Int?
  vrsFactors    String?   @db.Text
  vrsComputedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  assignee    User?       @relation("VulnerabilityAssignee", fields: [assignedTo], references: [id])

  // SetNull, não Cascade: apagar um scan DAST antigo NÃO pode apagar a
  // Vulnerability que nasceu dele — depois de promovida ela é um achado do
  // projeto, com triagem, evidências e comentários próprios. Perde-se o
  // ponteiro pra origem, nunca o achado.
  sourceDastFinding DastFinding? @relation("VulnerabilityFromDastFinding", fields: [sourceDastFindingId], references: [id], onDelete: SetNull)

  evidences       Evidence[]
  comments        VulnerabilityComment[]
  riskAcceptances RiskAcceptance[] // CP-4 — histórico de aceites formais deste finding

  @@index([projectId])
  @@index([applicationId])
  @@index([companyId])
  // Filtros mais usados nas listagens
  @@index([companyId, status])
  @@index([companyId, severityFinal])
  @@index([projectId, status])
  // SLA (CP-2): "vencidos da empresa" e ordenação por prazo
  @@index([companyId, slaDueAt])
  // VRS (CP-3): "abertos da empresa por prioridade" — o recorte do Kanban e do dashboard
  @@index([companyId, status, vrsScore])
}

// ============================================================================
// SLA DE REMEDIAÇÃO (Exposure & Remediation, CP-2)
// ============================================================================
//
// Política de prazos por severidade. Uma por tenant (companyId), mais UMA
// política padrão do produto com companyId = null — o fallback de quem nunca
// configurou a sua.
//
// VERSIONADA, NÃO EDITADA: alterar a política cria uma linha nova e desativa
// a anterior. O prazo já gravado em cada Vulnerability (`slaDueAt`) aponta
// para a política que o gerou (`slaPolicyId`) e NÃO muda sozinho — é o que
// impede "consertar" um estouro afrouxando a regra. Reaplicar aos findings
// abertos é ação explícita de ADMIN, auditada (SLA_POLICY_APPLIED).
//
// "No máximo uma ativa por company" é regra de service: o MySQL não tem
// unique parcial, e as inativas precisam poder coexistir (são o histórico).
model SlaPolicy {
  id           String   @id @default(cuid())
  companyId    String? // null = política PADRÃO do produto
  name         String
  criticalDays Int      @default(2)
  highDays     Int      @default(7)
  mediumDays   Int      @default(30)
  lowDays      Int      @default(90)
  isActive     Boolean  @default(true)
  createdBy    String // userId (ou "system" na política padrão do seed)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
}

// ============================================================================
// RISK ACCEPTANCE (Exposure & Remediation, CP-4)
// ============================================================================
//
// Aceite FORMAL de risco — entidade própria, NUNCA um status de Vulnerability
// (D10). A vulnerabilidade continua OPEN/IN_PROGRESS enquanto o aceite vale:
// "risco aceito" e "finding fechado" são coisas diferentes, e colapsá-los no
// mesmo campo destruiria exatamente a informação que torna o aceite
// defensável numa auditoria — quem pediu, quem assinou, até quando, por quê.
//
// status: REQUESTED → APPROVED | REJECTED
//         APPROVED  → REVOKED | EXPIRED
//         (REJECTED, REVOKED, EXPIRED são terminais)
//
// IMUTÁVEL DEPOIS DA DECISÃO: não existe UPDATE de reason/expiresAt. Estender
// = novo REQUESTED. É o que fecha o vetor "expiração manipulável".
//
// Segregação de função: requestedById ≠ reviewedById, sempre, inclusive
// ADMIN. PENTESTER nunca aprova (pode pedir). Regra no service.
//
// EXPIRAÇÃO PREGUIÇOSA (sem scheduler, ADR-030): APPROVED com expiresAt no
// passado é lido como EXPIRED; a primeira leitura que perceber consolida a
// transição com UM updateMany condicional (status='APPROVED') — o count
// devolvido diz quem "ganhou" e audita uma vez só, sem condição de corrida.
//
// companyId desnormalizado da Vulnerability — mesmo padrão RN09, nunca vem
// do cliente. "Um aceite ativo por vez" é regra de service (unique parcial
// não existe no MySQL; os terminais precisam coexistir — são o histórico).
model RiskAcceptance {
  id                    String    @id @default(cuid())
  vulnerabilityId       String
  companyId             String
  status                String    @default("REQUESTED")
  reason                String    @db.Text
  businessJustification String    @db.Text
  compensatingControls  String?   @db.Text
  requestedById         String
  requestedAt           DateTime  @default(now())
  /** Prazo pedido pelo solicitante; o aprovador pode encurtar (nunca alongar além do teto). */
  requestedExpiresAt    DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNote            String?   @db.Text
  /** Obrigatório em APPROVED. Teto de 365 dias a partir da aprovação. */
  expiresAt             DateTime?
  revokedAt             DateTime?
  revokedById           String?
  revokeReason          String?   @db.Text
  /** Quando o aceite deixou de valer (revogado ou expirado) — o fim do intervalo que pausa o SLA. */
  endedAt               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  company       Company       @relation(fields: [companyId], references: [id])
  requestedBy   User          @relation("RiskAcceptanceRequester", fields: [requestedById], references: [id])
  reviewedBy    User?         @relation("RiskAcceptanceReviewer", fields: [reviewedById], references: [id])

  @@index([vulnerabilityId])
  @@index([companyId, status])
  // varredura de expiração e "aceite ativo?" na busca
  @@index([status, expiresAt])
}

// Evidence — anexo de prova (imagem ou log)
// Tipos aceitos: jpg, jpeg, png, txt, log
// Validação MIME + magic number no upload. Limite 10MB.
// Nomes reescritos com UUID antes de gravar em disco.
model Evidence {
  id              String   @id @default(cuid())
  vulnerabilityId String
  fileName        String // nome reescrito (UUID + ext)
  originalName    String // nome enviado pelo usuário
  filePath        String // caminho relativo no volume
  mimeType        String
  sizeBytes       Int
  proof           String   @db.Text // descrição do que gerou a evidência (payload, request, etc)
  uploadedBy      String // userId
  createdAt       DateTime @default(now())

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  uploader      User          @relation(fields: [uploadedBy], references: [id])

  @@index([vulnerabilityId])
}

// VulnerabilityComment — thread de discussão por finding
model VulnerabilityComment {
  id              String   @id @default(cuid())
  vulnerabilityId String
  authorId        String
  content         String   @db.Text
  createdAt       DateTime @default(now())

  vulnerability Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  author        User          @relation(fields: [authorId], references: [id])

  @@index([vulnerabilityId])
}

// ============================================================================
// AUDITORIA
// ============================================================================

// AuditLog — trilha de ações sensíveis
// entityType: "Vulnerability" | "Subscription" | "Report" | "User" | "Project"
// action: "CREATE" | "UPDATE" | "DELETE" | "SEVERITY_OVERRIDE" | "STATUS_CHANGE" | "APPROVE"
// diffJson: snapshot do "antes/depois" em JSON
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  companyId  String? // null para ações globais (admin)
  entityType String
  entityId   String
  action     String
  diffJson   String?  @db.Text
  createdAt  DateTime @default(now())

  actor   User     @relation(fields: [actorId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([actorId])
}

// ============================================================================
// MATURIDADE (Sprint 8)
// ============================================================================
//
// MaturityAssessment é a avaliação de UMA Company. Não tem projectId direto
// (uma assessment vale para toda a company, não para um projeto específico).
// Score consolidado é derivado dos MaturityScore individuais por subcontrole.
//
// MaturityDomain e MaturityControl são SEEDS (catálogo). Não há CRUD público;
// admins do produto criam via seed/migration.

model MaturityDomain {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text
  sortOrder   Int     @default(0)

  controls MaturityControl[]
}

model MaturityControl {
  id          String  @id @default(cuid())
  domainId    String
  name        String
  description String? @db.Text
  sortOrder   Int     @default(0)

  domain MaturityDomain  @relation(fields: [domainId], references: [id])
  scores MaturityScore[]

  @@index([domainId])
}

model MaturityAssessment {
  id           String   @id @default(cuid())
  companyId    String
  overallScore Float    @default(0)
  level        String   @default("BASIC") // BASIC | INTERMEDIATE | ADVANCED
  notes        String?  @db.Text
  evaluatedBy  String // userId do admin
  createdAt    DateTime @default(now())

  scores MaturityScore[]

  @@index([companyId])
}

model MaturityScore {
  id           String  @id @default(cuid())
  assessmentId String
  controlId    String
  score        Int // 1..5
  isCompliant  Boolean @default(false)
  notes        String? @db.Text

  assessment MaturityAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  control    MaturityControl    @relation(fields: [controlId], references: [id])

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
  @@index([controlId])
}

// ============================================================================
// NOTIFICAÇÕES E RELATÓRIOS (Sprint 6-7)
// ============================================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  category    String // "FINDING_CRITICAL" | "STATUS_CHANGE" | "COMMENT" | "TICKET"
  title       String
  message     String   @db.Text
  isRead      Boolean  @default(false)
  sentAsPush  Boolean  @default(false)
  sentAsEmail Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// Report — apenas METADADO do PDF gerado. O PDF em si é gerado client-side.
model Report {
  id          String   @id @default(cuid())
  projectId   String
  type        String // "EXECUTIVE" | "TECHNICAL"
  title       String
  generatedBy String // userId
  createdAt   DateTime @default(now())

  @@index([projectId])
}

// ============================================================================
// DAST (módulo de scans automatizados via OWASP ZAP)
// ============================================================================
//
// Silo próprio: os findings do ZAP NÃO viram Vulnerability (ver ADR em
// docs/Vulnera/07-Decisoes/ - "DAST como silo"). Motivo principal: o ZAP não
// fornece vetor CVSS, só riskcode (HIGH/MEDIUM/LOW/INFO) — importar exigiria
// inventar um vetor, o que contamina o cálculo automático que o resto do
// schema depende (severityCalculated derivado de cvssScore).
//
// ⚠️ EXCEÇÃO à filosofia #3 do cabeçalho ("Sem enums nativos"): DastScanStatus
// e DastRisk usam enum nativo do Prisma, não String. Os dois conjuntos de
// valores são fechados por contrato externo (DastRisk é a taxonomia fixa do
// ZAP; DastScanStatus é uma máquina de estados interna de 5 valores) e não se
// espera adicionar valor sem tocar código de qualquer forma. Decisão
// registrada em docs/Vulnera/07-Decisoes/ (ADR "DAST como silo") — sinalizada
// ao Rafael por divergir da regra geral do schema.
//
// MaturityAssessment.companyId não tem FK à Company (deploy pré-Fase 5); aqui
// requestedById TEM FK a User desde o início, seguindo o padrão já
// consolidado no restante do schema (Vulnerability.assignee, etc.).

enum DastScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DastRisk {
  HIGH
  MEDIUM
  LOW
  INFO
}

// Triagem de um DastFinding pelo pentester, DENTRO do silo DAST (ADR-032).
// Um scan devolve dezenas de alertas e o ZAP não sabe quais importam: sem
// isso, quem revisa 40 achados não tem onde registrar o que já analisou e
// recomeça do zero na próxima sessão.
//   NEW            — ainda não olhado (padrão de todo finding recém-importado)
//   CONFIRMED      — o pentester validou: é real
//   FALSE_POSITIVE — o ZAP errou
//   ACCEPTED_RISK  — é real, mas o risco foi aceito conscientemente
enum DastTriageStatus {
  NEW
  CONFIRMED
  FALSE_POSITIVE
  ACCEPTED_RISK
}

// DastScan — uma execução de scan DAST contra uma targetUrl.
// containerName é derivado de `id` (vulnera-zap-<id>) e persistido pra
// permitir cancelamento (docker rm -f <containerName>) sem recalcular nada.
//
// progress/phase/simulated/warningMessage entraram em 2026-09-09 (scan real
// dentro da stack Docker). O motivo de os quatro serem COLUNA e não estado em
// memória: o scan roda em background e a UI acompanha por polling — quem
// responde o GET /dast/scans/:id pode ser outro processo (ou o mesmo depois
// de um restart), então o banco é o único lugar onde o progresso sobrevive.
model DastScan {
  id             String         @id @default(cuid())
  targetUrl      String         @db.VarChar(2048)
  status         DastScanStatus @default(QUEUED)
  requestedById  String
  containerName  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  errorMessage   String?        @db.Text
  htmlReportPath String?
  jsonReportPath String?
  // 0..100 — percentual consolidado das fases (spider/passivo/ativo), escrito
  // pelo runner a cada tick de polling da API do ZAP.
  progress       Int            @default(0)
  // Fase corrente em texto livre curto (QUEUED, STARTING, SPIDER, PASSIVE,
  // ACTIVE, REPORT, DONE, SIMULATED). String e não enum nativo de propósito:
  // é rótulo de UI, não máquina de estados — status já é a máquina.
  phase          String?
  // true quando o resultado veio do gerador simulado (Docker indisponível ou
  // scan real falhou e caiu no fallback). Antes de 2026-09-09 essa informação
  // existia só dentro do report.json e era invisível na aplicação inteira.
  simulated      Boolean        @default(false)
  // Aviso amigável quando o scan CONCLUIU mas com ressalva (tipicamente o
  // fallback simulado). Distinto de errorMessage, que só existe em FAILED.
  warningMessage String?        @db.Text
  alertsHigh     Int            @default(0)
  alertsMedium   Int            @default(0)
  alertsLow      Int            @default(0)
  alertsInfo     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  requestedBy User          @relation(fields: [requestedById], references: [id])
  findings    DastFinding[]

  @@index([requestedById])
  @@index([status])
  // Índice composto pro lock "1 scan por alvo de cada vez": WHERE status IN
  // (QUEUED,RUNNING) AND targetUrl = ?. Prefixo de 191 chars — targetUrl é
  // VarChar(2048), índice completo estouraria o teto de bytes por índice do
  // MySQL (o projeto já foi mordido nisso duas vezes, ver §2 do CLAUDE.md).
  @@index([status, targetUrl(length: 191)])
}

// DastFinding — um alerta do ZAP já normalizado (1 instance = 1 finding).
// fingerprint = sha256(pluginId + "|" + normalizedUrl + "|" + (param ?? ""))
// — NUNCA inclui evidence (ela muda entre scans da mesma vulnerabilidade).
model DastFinding {
  id            String   @id @default(cuid())
  scanId        String
  fingerprint   String // sha256 hex, 64 chars — seguro pro índice único
  pluginId      String
  title         String
  risk          DastRisk
  confidence    String
  cweId         String?
  wascId        String?
  url           String   @db.Text
  normalizedUrl String   @db.Text
  param         String?
  evidence      String?  @db.Text
  description   String?  @db.Text
  solution      String?  @db.Text
  reference     String?  @db.Text
  createdAt     DateTime @default(now())

  // ---------------------------------------------------------------------
  // Triagem dentro do silo (ADR-032). Não substitui a promoção pra
  // Vulnerability: é o passo ANTES dela — o pentester marca o que já
  // analisou, e só o que virou CONFIRMED costuma merecer promoção.
  // ---------------------------------------------------------------------
  triageStatus DastTriageStatus @default(NEW)
  triageNote   String?          @db.Text
  triagedById  String?
  triagedAt    DateTime?

  scan      DastScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  triagedBy User?    @relation("DastFindingTriagedBy", fields: [triagedById], references: [id])

  // Lado inverso da promoção — a FK real mora em Vulnerability.sourceDastFindingId.
  // Sendo @unique lá, este lado é 0..1: um finding vira no máximo UMA
  // Vulnerability (a deduplicação que o ADR-029 pedia, garantida pelo banco
  // e não por checagem de aplicação).
  promotedVulnerability Vulnerability? @relation("VulnerabilityFromDastFinding")

  @@unique([scanId, fingerprint])
  @@index([scanId])
  @@index([risk])
  // Filtro "só o que ainda não triei" na tela de findings.
  @@index([scanId, triageStatus])
}

