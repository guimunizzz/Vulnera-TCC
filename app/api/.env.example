# Application
SERVER_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (MySQL — banco TEMPORÁRIO; ver ADR-008)
# Para migrar para PostgreSQL no futuro:
#   - trocar `provider = "mysql"` por `provider = "postgresql"` em schema.prisma
#   - ajustar a URL abaixo (ex: postgresql://user:senha@localhost:5432/vulnera)
DATABASE_URL="mysql://root:1234@localhost:3306/vulnera"

# JWT — nunca commitar valores reais (mínimo 32 chars aleatórios em prod)
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_to_another_long_random_string
JWT_REFRESH_TTL=7d

# bcrypt — cost 12 em produção, 4 em testes (mais rápido)
BCRYPT_COST=12

# Evidências de Vulnerability (Fase 5) — caminho relativo ao cwd do processo.
# .env.test usa "uploads-test" pra nunca escrever arquivo de teste dentro do
# volume real de dev.
UPLOADS_DIR=uploads

# DAST (módulo de scans via OWASP ZAP) — ver src/services/zap-runner.service.ts
# Relatórios (report.json/report.html) de cada scan, caminho relativo ao cwd.
DAST_REPORTS_DIR=dast-reports
# Imagem Docker do ZAP usada por `docker run`.
DAST_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# Tempo máximo (ms) de um scan antes de matar o container e marcar FAILED.
DAST_SCAN_TIMEOUT_MS=1800000
# ⚠️ SSRF: false bloqueia loopback/faixas privadas (127/8, 10/8, 172.16/12,
# 192.168/16, 169.254/16, localhost, ::1) como alvo de scan. Só ligue "true"
# em desenvolvimento local pra escanear alvos como o Juice Shop (Fase 8).
DAST_ALLOW_PRIVATE_TARGETS=false
# Rede Docker onde criar o container do ZAP. VAZIO = API rodando no host
# (`npm run dev`): o runner publica uma porta efêmera em 127.0.0.1 e fala com
# o ZAP por lá. Dentro do docker compose, vem preenchido com "vulnera-net" —
# aí API e ZAP ficam na mesma rede e a API alcança o daemon pelo NOME do
# container, sem publicar porta nenhuma.
DAST_ZAP_NETWORK=
# Teto de scans simultâneos. Cada scan = um container do ZAP com uma JVM
# própria (~1GB); o watchdog enfileira o que passar disso.
DAST_MAX_CONCURRENT_SCANS=2
# Tempo máximo esperando o daemon do ZAP responder depois do `docker run`
# (a JVM leva ~20-40s pra subir).
DAST_ZAP_STARTUP_TIMEOUT_MS=180000
# Teto de minutos do spider — sem ele um alvo grande rastreia até o timeout
# global do scan. 0 desliga o limite.
DAST_ZAP_SPIDER_MAX_DURATION_MIN=5
# Silêncio máximo tolerado num scan em execução antes de o watchdog abortar
# (o runner pulsa a cada ~3s enquanto conversa com o ZAP).
DAST_HEARTBEAT_TIMEOUT_MS=120000
# "true" pula o ZAP e devolve o relatório simulado. Obrigatório em .env.test
# (a suíte não pode depender de Docker) e útil pra demonstrar a UI sem esperar
# um scan real.
DAST_FORCE_SIMULATE=false
