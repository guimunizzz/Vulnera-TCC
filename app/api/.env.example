# Application
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (MySQL — banco TEMPORÁRIO; ver ADR-008)
# Para migrar para PostgreSQL no futuro:
#   - trocar `provider = "mysql"` por `provider = "postgresql"` em schema.prisma
#   - ajustar a URL abaixo (ex: postgresql://user:senha@localhost:5432/vulnera)
DATABASE_URL="mysql://root:1234@localhost:3306/vulnera"

# JWT — nunca commitar valores reais (mínimo 32 chars aleatórios em prod)
JWT_ACCESS_SECRET=change_this_access_secret_to_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_to_another_long_random_string
JWT_REFRESH_TTL=7d

# bcrypt — cost 12 em produção, 4 em testes (mais rápido)
BCRYPT_COST=12

# Evidências de Vulnerability (Fase 5) — caminho relativo ao cwd do processo.
# .env.test usa "uploads-test" pra nunca escrever arquivo de teste dentro do
# volume real de dev.
UPLOADS_DIR=uploads

# DAST (módulo de scans via OWASP ZAP) — ver src/services/zap-runner.service.ts
# Relatórios (report.json/report.html) de cada scan, caminho relativo ao cwd.
DAST_REPORTS_DIR=dast-reports
# Imagem Docker do ZAP usada por `docker run`.
DAST_ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:stable
# Tempo máximo (ms) de um scan antes de matar o container e marcar FAILED.
DAST_SCAN_TIMEOUT_MS=1800000
# Alvos HTTP/HTTPS internos e públicos são aceitos sem flag adicional.
# Use um endereço alcançável pelo ZAP: IP da LAN, nome de serviço Docker ou
# host.docker.internal para um servidor no host do Docker Desktop.
# Rede Docker onde criar o container do ZAP. VAZIO = API rodando no host
# (`npm run dev`): o runner publica uma porta efêmera em 127.0.0.1 e fala com
# o ZAP por lá. Dentro do docker compose, vem preenchido com "vulnera-net" —
# aí API e ZAP ficam na mesma rede e a API alcança o daemon pelo NOME do
# container, sem publicar porta nenhuma.
DAST_ZAP_NETWORK=
# Teto de scans simultâneos. Cada scan = um container do ZAP com uma JVM
# própria (~1GB); o watchdog enfileira o que passar disso.
DAST_MAX_CONCURRENT_SCANS=1
# Tempo máximo esperando o daemon do ZAP responder depois do `docker run`
# (a JVM leva ~20-40s pra subir).
DAST_ZAP_STARTUP_TIMEOUT_MS=180000
# Teto de minutos do Spider tradicional do ZAP (1..10; padrão 1).
# Valores inválidos/zero usam o padrão de 1 minuto, nunca tempo ilimitado.
DAST_ZAP_SPIDER_MAX_DURATION_MIN=1
# Silêncio máximo tolerado num scan em execução antes de o watchdog abortar
# (o runner pulsa a cada ~3s enquanto conversa com o ZAP).
DAST_HEARTBEAT_TIMEOUT_MS=120000
# "true" bloqueia execuções reais (proteção adicional em .env.test).
# A simulação é escolhida explicitamente no POST, nunca fallback de erro.
DAST_FORCE_SIMULATE=false
# Chave da API do NVD (NIST), usada para buscar o CVSS das CVEs. OPCIONAL:
# sem ela o NVD aceita 5 consultas a cada 30 s e cada scan enriquece no máximo
# 25 CVEs ainda fora do cache (as outras ficam com "CVSS pendente").
# Pedido gratuito: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Rate limiting — Token Bucket em memória, apropriado somente para uma instância.
# Em produção a proteção nasce ligada; desligar só em teste de capacidade isolado.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_RPS=5
RATE_LIMIT_GLOBAL_BURST=15
RATE_LIMIT_TENANT_RPS=2
RATE_LIMIT_TENANT_BURST=10
RATE_LIMIT_USER_RPS=1
RATE_LIMIT_USER_BURST=10
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_REPORT_PER_MINUTE=3
RATE_LIMIT_DAST_PER_MINUTE=2
RATE_LIMIT_EXPORT_PER_MINUTE=6
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_STORE_TTL_MS=600000
RATE_LIMIT_STORE_MAX_KEYS=5000
RATE_LIMIT_TENANT_CACHE_TTL_MS=60000
RATE_LIMIT_TENANT_CACHE_MAX_KEYS=1000
# 0 no Docker/local; 1 atrás do proxy único do Render. Nunca usar true.
TRUST_PROXY_HOPS=0

# E-mail de verificação. MailHog local não usa autenticação nem TLS.
# Em produção, use SMTP com TLS (secure ou requireTLS) e uma origem HTTPS pública.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost.test
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
PUBLIC_WEB_URL=http://localhost:3000

# Turnstile (Siteverify fail-closed). Segredo obrigatório para usar endpoints públicos.
# Em produção, hostname e action são obrigatórios e devem corresponder aos campos
# retornados por Siteverify. Use o hostname público permitido no Cloudflare e a
# action configurada no widget (por exemplo, access-request). Em development/teste,
# essas expectativas podem ser omitidas; segredos dummy só são aceitos fora de production.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=access-request
TURNSTILE_TIMEOUT_MS=5000

# Token Bucket: MAX define burst e WINDOW_MS o refill completo (não janela fixa).
# Limites próprios de AccessRequest, independentes de RATE_LIMIT_ENABLED.
RATE_LIMIT_ACCESS_REQUEST_IP_MAX=5
RATE_LIMIT_ACCESS_REQUEST_IP_WINDOW_MS=3600000
RATE_LIMIT_ACCESS_RESEND_IP_MAX=10
RATE_LIMIT_ACCESS_RESEND_IP_WINDOW_MS=3600000
RATE_LIMIT_ACCESS_VERIFY_IP_MAX=30
RATE_LIMIT_ACCESS_VERIFY_IP_WINDOW_MS=60000
RATE_LIMIT_ACCESS_EMAIL_MAX=5
RATE_LIMIT_ACCESS_EMAIL_WINDOW_MS=86400000
ACCESS_REQUEST_RESEND_COOLDOWN_MS=60000
ACCESS_INVITATION_RESEND_COOLDOWN_MS=60000
RATE_LIMIT_ACCESS_STORE_MAX_KEYS=5000
RATE_LIMIT_ACCOUNT_ACTIVATION_VALIDATE_IP_PER_MINUTE=30
RATE_LIMIT_ACCOUNT_ACTIVATION_VALIDATE_TOKEN_PER_MINUTE=30
RATE_LIMIT_ACCOUNT_ACTIVATION_ACTIVATE_IP_PER_MINUTE=5
RATE_LIMIT_ACCOUNT_ACTIVATION_ACTIVATE_TOKEN_PER_MINUTE=5
RATE_LIMIT_ACCOUNT_ACTIVATION_STORE_MAX_KEYS=5000

# Orçamento por ZAP para WSL de 4 GB: um scan por vez.
DAST_ZAP_MEMORY=2g
DAST_ZAP_CPUS=2
# Consultas idempotentes ao daemon (ações de navegação não são repetidas).
DAST_ZAP_HTTP_TIMEOUT_MS=45000
DAST_ZAP_HTTP_ATTEMPTS=3

# Exportacao Excel de findings (GET /api/vulnerabilities/export.xlsx): teto de linhas por
# arquivo. Acima disso a API responde 422 EXPORT_LIMIT_EXCEEDED, nunca um arquivo truncado.
# A geracao e sincrona (streaming); o modo assincrono para volumes maiores ainda nao existe.
EXPORT_MAX_ROWS=50000

# Assistente Vulnera: local funciona sem chave nem chamadas externas.
# Chave somente no backend; configure privadamente, nunca no frontend ou Git.
# Para Gemini, confirme projeto Free Tier SEM faturamento/trial e cotas no AI Studio.
# Este arquivo é o modelo para a API executada no host: copie para app/api/.env.
# No arquivo privado, preencha GEMINI_API_KEY e altere ASSISTANT_MODE para gemini;
# reinicie a API somente após todos os scans terminarem.
# Para Docker Compose, siga o passo a passo do .env.example da RAIZ e configure
# o .env da raiz. O Compose não lê app/api/.env para essas variáveis.
# Instruções completas e validação do selo Gemini: docs/ASSISTENTE_VULNERA.md.
ASSISTANT_MODE=local
GEMINI_API_KEY=
# Identificador autorizado: preencher somente no .env privado, sem publicar a escolha.
GEMINI_MODEL=
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_MAX_OUTPUT_TOKENS=500
# Tentativas de geração Gemini: reposição contínua + rajada, separadas das cotas Google.
# Saudações/apresentações e ajuda local não gastam estes buckets; limites gerais da API continuam ativos.
# Esgotamento retorna Ajuda local e prazo para nova tentativa manual, sem aumentar estes valores.
RATE_LIMIT_ASSISTANT_USER_PER_HOUR=10
RATE_LIMIT_ASSISTANT_USER_BURST=20
RATE_LIMIT_ASSISTANT_GLOBAL_PER_HOUR=30
RATE_LIMIT_ASSISTANT_GLOBAL_BURST=20

# Threat Intel (ADR-053): sincronização com NVD, OSV, CISA KEV e EPSS dentro da API.
# false desliga o agendador (o botão "Sincronizar agora" do ADMIN continua funcionando).
THREAT_INTEL_SYNC_ENABLED=true
# Intervalo entre execuções, em minutos (mínimo 15).
THREAT_INTEL_SYNC_INTERVAL_MIN=360

# Fila de jobs (ADR-056). memory = comportamento atual (fila DAST em memória e
# setInterval da Threat Intel). bullmq = fila persistente no Redis.
QUEUE_DRIVER=memory
# Só lida com QUEUE_DRIVER=bullmq. No compose a API usa redis://:<REDIS_PASSWORD>@redis:6379.
# Rodando a API no host, o Redis do compose NÃO é alcançável (não publica porta).
REDIS_URL=redis://:troque_esta_senha@localhost:6379
# false = a API não inicia os workers; rode-os à parte com `npm run worker`.
WORKER_IN_PROCESS=true

# Monitor de SLA: aviso diário (08:00, America/Sao_Paulo) de vulnerabilidades que vencem em até
# 3 dias ou já venceram. Só roda com QUEUE_DRIVER=bullmq (sem Redis não há agendamento diário).
# false remove o agendamento; o padrão é true.
SLA_MONITOR_ENABLED=true
