# Prefixo EXPO_PUBLIC_ é obrigatório — é assim que o Expo decide o que
# embutir no bundle em build time (mesmo mecanismo do VITE_ no app/web).
#
# ⚠️ localhost NÃO funciona no celular físico via Expo Go — o telefone não
# enxerga "localhost" da máquina de desenvolvimento. Troque pelo IP da sua
# rede local (ex: http://192.168.0.42:3001/api — descubra com `ipconfig`
# no Windows). Emulador Android usa 10.0.2.2 no lugar de localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
