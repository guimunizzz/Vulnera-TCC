{
  "expo": {
    "name": "Vulnera",
    "slug": "vulnera-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0d",
    "scheme": "vulnera",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.vulnera.mobile"
    },
    "android": {
      "package": "br.com.vulnera.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0d"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
