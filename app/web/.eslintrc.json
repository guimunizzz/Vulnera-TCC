{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint", "react-hooks", "react-refresh"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "browser": true,
    "es2023": true
  },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react-refresh/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "three",
            "message": "three só entra no kit src/three/ e nos hooks de cena carregados por lazy() — em outro lugar põe ~690 kB no bundle principal."
          },
          {
            "name": "gsap",
            "message": "GSAP é da landing e entra só por components/landing/motion/ (registro único dos plugins). O app autenticado usa Motion."
          }
        ],
        "patterns": [
          {
            "group": ["three/*", "@react-three/*"],
            "message": "three só entra no kit src/three/ e nos hooks de cena carregados por lazy()."
          },
          {
            "group": ["**/three/*", "!**/three/gate"],
            "message": "Do kit de cena, só three/gate (que não importa three) pode ser usado fora dos módulos lazy."
          },
          {
            "group": ["gsap/*", "@gsap/*"],
            "message": "GSAP é da landing e entra só por components/landing/motion/ (registro único dos plugins). O app autenticado usa Motion."
          },
          {
            "group": ["**/dashboard-ambient-canvas", "**/landing-root", "**/landing-scene-canvas"],
            "message": "Módulo de cena: carregue com lazy(() => import(...)), nunca com import estático."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/three/**",
        "src/components/dashboard/hero/use-dashboard-scene.ts",
        "src/components/landing/scene/use-landing-scene.ts",
        "src/components/landing/scene/shaders.ts",
        "src/features/security-graph/exposure-map-scene.ts"
      ],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/components/landing/motion/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
