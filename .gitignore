# Dependencies
node_modules/
.pnp
.pnp.js
package-lock.json

# Build outputs
dist/
.next/
out/
build/
coverage/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Prisma
app/api/prisma/migrations/*.sql
!app/api/prisma/migrations/.gitkeep

# Uploads (evidências) — path corrigido de "apps/" (plural, não existe) pra
# "app/" (singular, estrutura real do repo); regra duplicada e reforçada em
# app/api/.gitignore, que é a que realmente vale pro caminho relativo.
app/api/uploads/*
!app/api/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
CLAUDE.md
yarn-error.log*
pino-*.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Turbo
.turbo/

# Testing
coverage/

# Expo
apps/mobile/.expo/
apps/mobile/expo-env.d.ts

# Next.js
apps/web/.next/

# TypeScript
*.tsbuildinfo

# SonarQube
.sonarqube/

package-lock.json
TECH_STATUS.md
static-analysis.datadog.yml

# Artefatos de execução do Playwright (traces, screenshots, relatório HTML).
# Gerados a cada `npm run test:e2e --workspace=app/web`; só interessam na
# máquina que rodou a suíte, e um trace.zip por falha engorda o repo rápido.
test-results/
playwright-report/
blob-report/
.playwright/
